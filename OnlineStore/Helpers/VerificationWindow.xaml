<Window x:Class="OnlineStore.Helpers.VerificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение" Width="320" Height="170"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="15">
        <TextBlock Text="Введите код подтверждения:" Margin="0,0,0,8"/>
        <TextBox x:Name="TBCode" MaxLength="6" Margin="0,0,0,12"/>
        <Button Content="Подтвердить" Height="30" IsDefault="True" Click="BtConfirm_Click"/>
    </StackPanel>
</Window>
