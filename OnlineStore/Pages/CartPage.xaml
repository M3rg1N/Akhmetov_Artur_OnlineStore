<Page x:Class="OnlineStore.Pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Корзина">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Корзина" Grid.Row="0" FontSize="30" HorizontalAlignment="Center" Margin="0 0 0 15"/>
        <Grid Grid.Row="1" Margin="0 0 0 10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Товары в корзине" FontSize="20"/>
            <TextBlock Grid.Column="1" Text="Количество / Сумма" FontSize="20"/>
        </Grid>
        <ListView x:Name="LVCart" Grid.Row="2" HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4 6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding NameProduct}" FontSize="17"/>
                            <TextBlock Text="{Binding PriceProduct, StringFormat='{}{0:N2} руб. за шт.'}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="−" Width="28" Height="26" Click="BtDecrease_Click"/>
                            <TextBlock Text="{Binding Quantity}" Width="32" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Content="+" Width="28" Height="26" Click="BtIncrease_Click"/>
                            <TextBlock Text="{Binding TotalPrice, StringFormat='{}{0:N2} руб.'}" Width="125" TextAlignment="Right" VerticalAlignment="Center" Margin="10 0"/>
                            <Button Content="Удалить" Click="BtRemove_Click" Margin="10 0 0 0"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid Grid.Row="3" Margin="0 12 0 0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="TBlCartTotal" Grid.Column="0" FontSize="20" VerticalAlignment="Center"/>
            <Button x:Name="BtCheckout" Grid.Column="1" Width="240" Height="35" FontSize="20" Content="Оформить заказ" Click="BtCheckout_Click"/>
        </Grid>
    </Grid>
</Page>
