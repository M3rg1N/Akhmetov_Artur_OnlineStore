<Window x:Class="OnlineStore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация / Регистрация" Height="550" Width="1000" MinHeight="500" MinWidth="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="LoginGrid" Grid.Row="0" Visibility="Visible" Margin="0 20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="АВТОРИЗАЦИЯ" FontSize="30" HorizontalAlignment="Center" Margin="0 0 0 20"/>
                <TextBlock Text="Логин" FontSize="20"/>
                <TextBox x:Name="TBLoginAuth" Width="200" Height="28" FontSize="18" Margin="0 4 0 10"/>
                <TextBlock Text="Пароль" FontSize="20"/>
                <PasswordBox x:Name="TBPasswordAuth" Width="200" Height="28" FontSize="18" Margin="0 4 0 0"/>
                <TextBox x:Name="TBPasswordVisibleAuth" Width="200" Height="28" FontSize="18" Visibility="Collapsed" Margin="0 4 0 0"/>
                <CheckBox x:Name="CBShowPassword" Content="Показать пароль" FontSize="15" Margin="0 10 0 0"
                          Checked="CBShowPassword_Changed" Unchecked="CBShowPassword_Changed"/>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="RegisterGrid" Grid.Row="0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="350" HorizontalAlignment="Center" Margin="0 12 0 10">
                <TextBlock Text="РЕГИСТРАЦИЯ" FontSize="30" HorizontalAlignment="Center" Margin="0 0 0 10"/>
                <TextBlock Text="Придумайте логин" FontSize="20"/>
                <TextBox x:Name="TBLoginReg" Width="200" Height="27" FontSize="15" HorizontalAlignment="Left" Margin="0 2 0 6"/>
                <TextBlock Text="Придумайте пароль" FontSize="20"/>
                <PasswordBox x:Name="PBFirstPassword" Width="200" Height="27" FontSize="15" HorizontalAlignment="Left" Margin="0 2 0 6"/>
                <TextBlock Text="Повторите пароль" FontSize="20"/>
                <PasswordBox x:Name="PBSecondPassword" Width="200" Height="27" FontSize="15" HorizontalAlignment="Left" Margin="0 2 0 6"/>
                <TextBlock Text="Введите номер телефона" FontSize="20"/>
                <TextBox x:Name="TBPhoneReg" Width="200" Height="27" FontSize="15" HorizontalAlignment="Left" Margin="0 2 0 6"/>
                <TextBlock Text="Введите почту" FontSize="20"/>
                <TextBox x:Name="TBEmailReg" Width="200" Height="27" FontSize="15" HorizontalAlignment="Left" Margin="0 2 0 6"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0 5 0 22">
            <Button x:Name="BtRegAuth" Width="200" Height="30" FontSize="15" Content="Войти" Click="BtRegAuth_Click"/>
            <Button x:Name="BtSwitchRegAuth" Width="200" Height="30" FontSize="15" Content="Нет аккаунта? Регистрация"
                    Click="BtSwitchRegAuth_Click" Margin="0 5 0 0"/>
            <Button x:Name="BtGuest" Width="200" Height="30" FontSize="15" Content="Продолжить как гость"
                    Click="BtGuest_Click" Margin="0 5 0 0"/>
        </StackPanel>
    </Grid>
</Window>
