<Window x:Class="OnlineStore.StoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Интернет-магазин" Height="650" Width="1050" MinWidth="750" MinHeight="500">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 5 0 8">
            <Button x:Name="BtCatalog" Width="120" Height="30" Content="Каталог" Margin="0 0 20 0" Click="BtCatalog_Click"/>
            <Button x:Name="BtCart" Width="120" Height="30" Content="Корзина" Margin="0 0 20 0" Click="BtCart_Click"/>
            <Button x:Name="BtProfile" Width="120" Height="30" Content="Профиль" Margin="0 0 20 0" Click="BtProfile_Click"/>
            <Button x:Name="BtAdmin" Width="120" Height="30" Content="Управление" Click="BtAdmin_Click"/>
        </StackPanel>
        <Frame x:Name="FrStore" Grid.Column="1" Grid.Row="2" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
